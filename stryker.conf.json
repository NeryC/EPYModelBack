{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "_comment": "Mutation testing focused on business-logic layers (domain + application + utils). Infrastructure and config are excluded due to I/O dependence.",
  "packageManager": "npm",
  "reporters": ["html", "clear-text", "progress"],
  "testRunner": "vitest",
  "vitest": {
    "configFile": "vitest.config.ts",
    "project": "unit"
  },
  "coverageAnalysis": "perTest",
  "mutate": [
    "src/domain/**/*.ts",
    "src/application/**/*.ts",
    "src/utils/**/*.ts",
    "src/shared/**/*.ts",
    "!src/**/*.test.ts",
    "!src/**/*.spec.ts",
    "!src/**/index.ts"
  ],
  "checkers": ["typescript"],
  "tsconfigFile": "tsconfig.json",
  "thresholds": { "high": 85, "low": 75, "break": 75 },
  "timeoutMS": 30000,
  "concurrency": 2,
  "htmlReporter": { "fileName": "reports/mutation/index.html" }
}
