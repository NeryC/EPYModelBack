# Environment Configuration
NODE_ENV=development
PORT=3001
LOG_LEVEL=debug

# CORS Configuration
CORS_ORIGIN=http://localhost:3000,http://localhost:3001

# Redis Configuration (optional)
REDIS_URL=redis://localhost:6379

# Python/R Scripts Paths (if different from default)
PYTHON_PATH=python
R_PATH=R

# Límites de peticiones por IP (ventana en minutos).
# RATE_LIMIT_MAX aplica a toda la API; SIMULATION_RATE_LIMIT_MAX a los
# endpoints que ejecutan simulador.py (cada simulación ~0,7 s de CPU).
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX=10000
SIMULATION_RATE_LIMIT_MAX=2000

# Tiempo máximo de una simulación (ms) antes de cortarla y responder 504.
SIMULATION_TIMEOUT_MS=60000

# Simulaciones simultáneas como máximo en todo el servidor (por defecto, una
# por núcleo de CPU) y cuántas pueden esperar turno; más allá se responde 503.
MAX_CONCURRENT_SIMULATIONS=4
SIMULATION_QUEUE_MAX=50
